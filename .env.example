# HTTP listen address
MOD_ADDR=:8096

# Where tenants, events and master.key live
MOD_DATA_DIR=./data

# Threshold policy file
MOD_POLICY=./policy.json

# OpenAI-compatible multimodal upstream (vLLM / SGLang / TGI / llama.cpp server / hosted)
MOD_UPSTREAM_URL=http://127.0.0.1:8000/v1/chat/completions
MOD_MODEL=Qwen/Qwen3.8-27B
MOD_UPSTREAM_KEY=
MOD_DISABLE_THINKING=true
MOD_UPSTREAM_TIMEOUT_SEC=180

# Limits
MOD_MAX_IMAGE_MB=12
MOD_MAX_VIDEO_MB=30
MOD_MAX_VIDEO_SEC=120
MOD_FRAMES_MAX=8

# Optional: set explicitly, otherwise generated once into $MOD_DATA_DIR/master.key
# MOD_MASTER_KEY=amk_master_change_me

# Jobs + webhooks
MOD_JOB_TTL_SEC=3600
MOD_WEBHOOK_TIMEOUT_SEC=15

# Shutdown
MOD_SHUTDOWN_GRACE_SEC=10
